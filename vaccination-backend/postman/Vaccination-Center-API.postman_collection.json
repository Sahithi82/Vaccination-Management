{
  "info": {
    "name": "Vaccination Center API",
    "description": "Beginner training collection for the Vaccination Center Express + MySQL backend. No JWT is used.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "userId",
      "value": "1"
    },
    {
      "key": "centerId",
      "value": "1"
    },
    {
      "key": "vaccinationId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "API Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Admin Login Success",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Nimda\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/login"
          }
        },
        {
          "name": "Admin Login Failure",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"wrong\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/login"
          }
        },
        {
          "name": "Create Center",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Community Health Center\",\n  \"address\": \"Kukatpally\",\n  \"city\": \"Hyderabad\",\n  \"state\": \"Telangana\",\n  \"pinCode\": \"500072\",\n  \"contactNumber\": \"04055556666\",\n  \"vaccineName\": \"Covishield\",\n  \"availableSlots\": 30,\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/centers"
          }
        },
        {
          "name": "Get All Centers",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/admin/centers"
          }
        },
        {
          "name": "Get Centers by PIN Code Query",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/admin/centers?pinCode=500072"
          }
        },
        {
          "name": "Get Center by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/admin/centers/{{centerId}}"
          }
        },
        {
          "name": "Update Center",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"availableSlots\": 45,\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/centers/{{centerId}}"
          }
        },
        {
          "name": "Delete Center",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/admin/centers/{{centerId}}"
          }
        },
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/admin/users"
          }
        },
        {
          "name": "Get All Vaccinations",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/admin/vaccinations"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Anita\",\n  \"email\": \"anita@gmail.com\",\n  \"password\": \"Anita@123\",\n  \"phone\": \"9876543211\",\n  \"pinCode\": \"500034\"\n}"
            },
            "url": "{{baseUrl}}/api/users/register"
          }
        },
        {
          "name": "User Login Success",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rahul@gmail.com\",\n  \"password\": \"Rahul@123\"\n}"
            },
            "url": "{{baseUrl}}/api/users/login"
          }
        },
        {
          "name": "User Login Failure",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rahul@gmail.com\",\n  \"password\": \"WrongPass\"\n}"
            },
            "url": "{{baseUrl}}/api/users/login"
          }
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/{{userId}}"
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9876500000\",\n  \"pinCode\": \"500072\"\n}"
            },
            "url": "{{baseUrl}}/api/users/{{userId}}"
          }
        }
      ]
    },
    {
      "name": "Vaccinations",
      "item": [
        {
          "name": "Get All Centers",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/vaccinations/centers"
          }
        },
        {
          "name": "Search Centers by PIN Code",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/vaccinations/centers?pinCode=500072"
          }
        },
        {
          "name": "Get Center by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/vaccinations/centers/{{centerId}}"
          }
        },
        {
          "name": "Book Vaccination",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"vaccinationDate\": \"2026-09-20\"\n}"
            },
            "url": "{{baseUrl}}/api/vaccinations/book"
          }
        },
        {
          "name": "Get Vaccination by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/vaccinations/{{vaccinationId}}"
          }
        },
        {
          "name": "Get Vaccinations by User",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/vaccinations/user/{{userId}}"
          }
        },
        {
          "name": "Update Vaccination Status",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"COMPLETED\"\n}"
            },
            "url": "{{baseUrl}}/api/vaccinations/{{vaccinationId}}/status"
          }
        },
        {
          "name": "Cancel Vaccination",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/vaccinations/{{vaccinationId}}"
          }
        }
      ]
    }
  ]
}
